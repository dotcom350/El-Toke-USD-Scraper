# Get a free key at https://www.firecrawl.dev
FIRECRAWL_API_KEY=fc-your-key-here

# Minutes between scrapes. Firecrawl's free tier gives 1000 credits/month
# and 1 scrape = 1 credit. 60 min -> ~720-744 credits/month (recommended,
# leaves buffer for manual testing and restarts).
SCRAPE_INTERVAL_MINUTES=60

# Host port to expose via docker compose
PORT=8000
