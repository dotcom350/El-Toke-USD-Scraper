# Get a free key at https://www.firecrawl.dev
FIRECRAWL_API_KEY=fc-your-key-here

# Minutes between scrapes. Each cycle scrapes all 9 tracked currencies
# (1 scrape = 1 Firecrawl credit each), so the cost is 9x a single-currency
# API. Firecrawl's free tier gives 1000 credits/month.
# 480 min (8h) -> 9 x 3/day x 30 = ~810 credits/month (recommended, leaves
# buffer for manual testing and restarts).
# 360 min (6h) -> ~1080/month (slightly over the free tier).
# 720 min (12h) -> ~540/month (very safe, coarser freshness).
SCRAPE_INTERVAL_MINUTES=480

# Host port to expose via docker compose
PORT=8000

# --- qvai (Telegram AI bot) + admin panel ---
# The Telegram bot token and NVIDIA API key are NOT set here - they're
# entered through the admin panel at /admin after deploying, so they can be
# changed at runtime without a redeploy. These three, however, ARE
# infrastructure and belong here:

# Password for the admin panel (/admin). Pick a strong one.
ADMIN_PASSWORD=change-me

# Random secret used to sign the admin login session cookie. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me

# Password for the bundled Postgres container (stores bot settings + the
# full conversation log). Generate with the same command as above.
POSTGRES_PASSWORD=change-me
